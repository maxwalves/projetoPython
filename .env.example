# =====================================================================
# MODELO de configuracao. Copie para .env se quiser ajustar algo:
#
#     cp .env.example .env
#
# TUDO AQUI E OPCIONAL. O projeto roda sem .env nenhum, usando os
# valores padrao do config/settings.py -- foi feito assim de proposito,
# para voce nao travar na configuracao antes de ver o sistema de pe.
#
# O .env NAO vai para o Git nem para o .zip da entrega (veja o
# .gitignore); este .env.example, sim: ele documenta QUAIS variaveis
# existem, sem revelar valores reais.
# =====================================================================

# Chave usada pelo Django para assinar sessoes e cookies.
# Para gerar uma nova:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=chave-de-desenvolvimento-troque-em-producao

# DEBUG=True mostra a pagina amarela de erro com o traceback completo.
# Otimo para estudar, PROIBIDO em producao (vaza codigo e configuracao).
DEBUG=True

# Hosts autorizados a servir a aplicacao. Separe por virgula.
ALLOWED_HOSTS=localhost,127.0.0.1

# O banco e SQLite e fica no arquivo escola.sqlite3, na raiz do
# projeto. Nao ha host, usuario nem senha para configurar.
